<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B1424" android:gravity="center"
    android:orientation="vertical" android:padding="28dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="#FFFFFF"
        android:textSize="32sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/tagline"
        android:textColor="#AAB9CC" android:textSize="14sp" />
    <TextView android:id="@+id/connectionStatus" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="56dp"
        android:text="@string/server_not_configured" android:textColor="#F5C46A"
        android:textSize="16sp" />
    <Button android:id="@+id/connectButton" android:layout_width="220dp"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="@string/connect" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="36dp" android:gravity="center"
        android:text="@string/setup_note" android:textColor="#AAB9CC"
        android:textSize="12sp" />
</LinearLayout>
