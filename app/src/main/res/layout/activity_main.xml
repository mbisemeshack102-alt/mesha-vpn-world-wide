<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1424"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tagline"
            android:textColor="#AAB9CC"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/disconnected"
            android:textColor="#F5C46A"
            android:textSize="16sp" />
        <EditText
            android:id="@+id/configInput"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#42C995"
            android:gravity="top|start"
            android:hint="@string/config_hint"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="14dp"
            android:scrollbars="vertical"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAB9CC"
            android:textSize="12sp"
            android:typeface="monospace" />
        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/connect" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/config_note"
            android:textColor="#AAB9CC"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
