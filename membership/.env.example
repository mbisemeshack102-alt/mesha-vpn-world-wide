# Copy to .env on your server. Never commit real secrets.
PORT=8080
NODE_ENV=production
DATABASE_FILE=./data/kem-membership.sqlite
# Generate with: openssl rand -hex 32
TOKEN_SECRET=replace_with_a_long_random_secret
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=replace_with_a_different_long_random_secret
# Six-digit owner PIN hash; create with the Node.js command in README. Never store the PIN itself here.
ADMIN_PIN_HASH=

# Set to clickpesa only after merchant approval and HTTPS deployment.
PAYMENT_PROVIDER=manual_review
PUBLIC_BASE_URL=https://api.your-domain.example

# Obtain these from ClickPesa Dashboard > Settings > Developers.
# Keep secrets on the VPS only. Never commit real credentials or put them in the APK.
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=

# Optional: set only if checksum is enabled for the ClickPesa application.
CLICKPESA_CHECKSUM_KEY=

# WireGuard peer provisioning (configure only on VPS after wg0 is created)
# Never put the server private key in this API environment or GitHub.
WIREGUARD_INTERFACE=wg0
WIREGUARD_ENDPOINT=vpn.your-real-domain.tld:51820
WIREGUARD_SERVER_PUBLIC_KEY=replace_with_server_public_key
WIREGUARD_CLIENT_CIDR=10.66.0.0/24
WIREGUARD_CLIENT_DNS=1.1.1.1, 1.0.0.1
WIREGUARD_CLIENT_ALLOWED_IPS=0.0.0.0/0
WIREGUARD_KEEPALIVE=25
