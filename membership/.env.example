# Copy to .env on your server. Never commit real secrets.
PORT=8080
NODE_ENV=production
DATABASE_FILE=./data/kem-membership.sqlite
# Generate with: openssl rand -hex 32
TOKEN_SECRET=replace_with_a_long_random_secret
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=replace_with_a_different_long_random_secret

# Set to clickpesa only after merchant approval and HTTPS deployment.
PAYMENT_PROVIDER=manual_review
PUBLIC_BASE_URL=https://api.your-domain.example

# Obtain these from ClickPesa Dashboard > Settings > Developers.
# Keep secrets on the VPS only. Never commit real credentials or put them in the APK.
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=

# Optional: set only if checksum is enabled for the ClickPesa application.
CLICKPESA_CHECKSUM_KEY=
